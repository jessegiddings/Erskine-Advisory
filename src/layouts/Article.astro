---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  /** Visible page heading; defaults to title. */
  heading?: string;
  kicker?: string;
  noindex?: boolean;
  ogImage?: string;
  jsonLd?: object[];
  /** Optional mono meta line under the heading (date, reading context, etc.) */
  metaLine?: string;
}

const { heading, kicker, metaLine, ...seo } = Astro.props;
---

<Base {...seo}>
  <article class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <header class="max-w-3xl">
      {kicker && <p class="annotation uppercase tracking-widest">{kicker}</p>}
      <h1 class="display-sm mt-3 text-balance">
        {heading ?? seo.title}
      </h1>
      {metaLine && <p class="annotation mt-4">{metaLine}</p>}
    </header>
    <div class="prose mt-10">
      <slot />
    </div>
    <slot name="after" />
  </article>
</Base>

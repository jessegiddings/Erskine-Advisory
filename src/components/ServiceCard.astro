---
interface Props {
  title: string;
  summary: string;
  whoItsFor: string;
  href: string;
  index: number;
}

const { title, summary, whoItsFor, href, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article class="border-t border-rule py-8">
  <div class="grid gap-4 sm:grid-cols-[6rem_1fr]">
    <p class="annotation">{num}</p>
    <div>
      <h3 class="text-lg font-semibold">
        <a href={href} class="hover:text-accent">
          {title}
        </a>
      </h3>
      <p class="mt-2 max-w-prose text-[0.95rem] leading-relaxed text-ink/90">{summary}</p>
      <p class="annotation mt-3">For: {whoItsFor}</p>
      <p class="mt-4">
        <a href={href} class="text-sm font-medium text-accent underline underline-offset-4">
          Read the full scope
        </a>
      </p>
    </div>
  </div>
</article>

---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import RiskLadder from '../../components/RiskLadder.astro';
import Plate from '../../components/Plate.astro';
import { SITE } from '../../lib/site';

// Shot-list plates per service (03-ART-DIRECTION §3). Captions are statements
// about the work — never locations, never projects.
const PLATES: Record<string, { src: string; alt: string; caption: string }> = {
  'remote-oversight': {
    src: '/plates/plate-11-aerial.svg',
    alt: 'Aerial plan view of a construction site with a marked verification zone',
    caption: 'Verification travels better than trust.',
  },
  'project-recovery': {
    src: '/plates/plate-12-shell.svg',
    alt: 'The bare concrete shell of an unfinished building with empty window openings',
    caption: 'A stalled project is an information problem first.',
  },
  'prefab-and-modular': {
    src: '/plates/plate-13-module.svg',
    alt: 'A prefabricated module suspended from a crane above its foundation',
    caption: 'Factory milestones deserve the same verification as site draws.',
  },
};

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.data.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.data.title,
    description: service.data.summary,
    serviceType: 'Owner’s representation (construction advisory)',
    provider: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
    },
    areaServed: ['Canada', 'United States'],
  },
];
---

<Article
  title={`${service.data.title} — ${SITE.name}`}
  heading={service.data.title}
  kicker="Service"
  description={service.data.summary}
  metaLine={`Fee shape: ${service.data.feeShape}`}
  jsonLd={jsonLd}
>
  {
    PLATES[service.data.slug] && (
      <Plate
        src={PLATES[service.data.slug].src}
        alt={PLATES[service.data.slug].alt}
        caption={PLATES[service.data.slug].caption}
        class="mb-10 aspect-[21/9]"
      />
    )
  }

  <Content />

  {service.data.slug === 'pre-construction-audit' && <RiskLadder />}

  <div slot="after" class="mt-14 max-w-3xl border-t border-rule pt-8">
    <p class="annotation">For: {service.data.whoItsFor}</p>
    <a
      href="/project-review"
      class="mt-5 inline-block bg-accent px-6 py-3 text-sm font-semibold text-paper hover:bg-ink"
    >
      Request a project review
    </a>
  </div>
</Article>

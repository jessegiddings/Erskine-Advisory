---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../lib/site';
---

<Base
  title="Received — Erskine Advisory"
  description="Your project review request has been received. A principal will reply within two business days."
  noindex={true}
>
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <div class="max-w-2xl">
      <p class="annotation uppercase tracking-widest">Received</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Thank you — it’s in front of us</h1>
      <p class="prose mt-5">
        Your request has been received and will be read by a principal, not routed through a pipeline. You
        will hear from us within two business days. If anything is urgent in the meantime, write directly to
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
      <p class="prose mt-4">
        While you wait, the most useful thing on this site is
        <a href="/the-owners-position">The Owner’s Position</a> — the argument for why representation exists
        and where it earns its fee.
      </p>
    </div>
  </div>
</Base>
